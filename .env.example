# Copier ce fichier en ".env" et renseigner vos clés.
# Aucune clé n'est nécessaire pour tester le projet en mode --demo.

# Fournisseur LLM par défaut : "claude", "mistral" ou "demo"
OPTIPILOT_PROVIDER=demo

# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modèle Claude utilisé
ANTHROPIC_MODEL=claude-sonnet-5

# Clé API Mistral (fallback souverain / UE) (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Modèle Mistral utilisé
MISTRAL_MODEL=mistral-large-latest
